rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn() && request.auth.token.active == true;
    }

    function hasRole(role) {
      return activeUser() && request.auth.token.role == role;
    }

    // User profile documents are private. Roles and activation are assigned
    // only through Firebase Admin SDK custom claims, never by the client.
    match /users/{userId} {
      allow read: if activeUser()
                  && (request.auth.uid == userId || hasRole('admin'));
      allow create, update, delete: if false;
    }

    // Default deny: financial collections receive explicit role-based rules
    // when their final document schema is introduced and tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
